{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowsight.local/schema/customer.v1.json",
  "title": "FlowSight Customer Config v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta","business","routing","hero","services","contact","trust","integrations"],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version","customer_id","locale","timezone"],
      "properties": {
        "schema_version": { "type": "string", "const": "1.0.0" },
        "customer_id": { "type": "string", "minLength": 2 },
        "locale": { "type": "string", "enum": ["de-CH"] },
        "timezone": { "type": "string", "enum": ["Europe/Zurich"] }
      }
    },
    "business": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name","tagline","region_label","brand"],
      "properties": {
        "name": { "type": "string", "minLength": 2 },
        "tagline": { "type": "string", "minLength": 2 },
        "region_label": { "type": "string", "minLength": 2 },
        "brand": {
          "type": "object",
          "additionalProperties": false,
          "required": ["logo","colors"],
          "properties": {
            "logo": {
              "type": "object",
              "additionalProperties": false,
              "required": ["src","alt"],
              "properties": {
                "src": { "type": "string", "minLength": 1 },
                "alt": { "type": "string", "minLength": 1 }
              }
            },
            "colors": {
              "type": "object",
              "additionalProperties": false,
              "required": ["accent"],
              "properties": {
                "accent": { "type": "string", "pattern": "^#([A-Fa-f0-9]{6})$" }
              }
            }
          }
        }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ctas","rules"],
      "properties": {
        "ctas": {
          "type": "object",
          "additionalProperties": false,
          "required": ["emergency","normal"],
          "properties": {
            "emergency": { "$ref": "#/$defs/cta" },
            "normal": { "$ref": "#/$defs/cta" }
          }
        },
        "rules": {
          "type": "object",
          "additionalProperties": false,
          "required": ["default_mode","after_hours_mode","busy_mode"],
          "properties": {
            "default_mode": { "type": "string", "enum": ["normal"] },
            "after_hours_mode": { "type": "string", "enum": ["emergency","chat","form"] },
            "busy_mode": { "type": "string", "enum": ["chat","form","call"] }
          }
        }
      }
    },
    "hero": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headline","subline","trust_badges"],
      "properties": {
        "headline": { "type": "string", "minLength": 5 },
        "subline": { "type": "string", "minLength": 5 },
        "trust_badges": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/badge" }
        }
      }
    },
    "services": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array",
          "minItems": 6,
          "maxItems": 9,
          "items": { "$ref": "#/$defs/service" }
        }
      }
    },
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bullets","reviews"],
      "properties": {
        "bullets": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": { "type": "string", "minLength": 5 }
        },
        "reviews": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source","headline","items","cta"],
          "properties": {
            "source": { "type": "string", "enum": ["google"] },
            "headline": { "type": "string", "minLength": 5 },
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 6,
              "items": { "$ref": "#/$defs/review" }
            },
            "cta": { "$ref": "#/$defs/cta" }
          }
        }
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phones","address","opening_hours","form","map"],
      "properties": {
        "phones": {
          "type": "object",
          "additionalProperties": false,
          "required": ["emergency","normal"],
          "properties": {
            "emergency": { "$ref": "#/$defs/phone" },
            "normal": { "$ref": "#/$defs/phone" }
          }
        },
        "address": {
          "type": "object",
          "additionalProperties": false,
          "required": ["street","zip","city","country"],
          "properties": {
            "street": { "type": "string", "minLength": 3 },
            "zip": { "type": "string", "minLength": 4 },
            "city": { "type": "string", "minLength": 2 },
            "country": { "type": "string", "enum": ["CH"] }
          }
        },
        "opening_hours": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label","weekly"],
          "properties": {
            "label": { "type": "string", "minLength": 3 },
            "weekly": {
              "type": "array",
              "minItems": 5,
              "maxItems": 7,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["day","hours"],
                "properties": {
                  "day": { "type": "string", "enum": ["Mo","Di","Mi","Do","Fr","Sa","So"] },
                  "hours": { "type": "string", "minLength": 3 }
                }
              }
            },
            "note": { "type": "string" }
          }
        },
        "form": {
          "type": "object",
          "additionalProperties": false,
          "required": ["headline","fields","consent_note"],
          "properties": {
            "headline": { "type": "string", "minLength": 5 },
            "fields": {
              "type": "array",
              "minItems": 5,
              "maxItems": 7,
              "items": { "$ref": "#/$defs/form_field" }
            },
            "consent_note": { "type": "string", "minLength": 10 }
          }
        },
        "map": {
          "type": "object",
          "additionalProperties": false,
          "required": ["embed_url"],
          "properties": {
            "embed_url": { "type": "string", "minLength": 10 }
          }
        }
      }
    },
    "integrations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chat","voice","analytics"],
      "properties": {
        "chat": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled","mode","lead_endpoint","slots"],
          "properties": {
            "enabled": { "type": "boolean" },
            "mode": { "type": "string", "enum": ["off","passive","proactive"] },
            "lead_endpoint": { "type": "string", "minLength": 1 },
            "slots": {
              "type": "array",
              "minItems": 6,
              "maxItems": 6,
              "items": { "type": "string", "enum": ["anliegen","plz_ort","dringlichkeit","name","telefon","zeitfenster"] }
            },
            "disclaimer": { "type": "string" }
          }
        },
        "voice": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled","demo_number","lead_endpoint","fallback_text","no_recording_default"],
          "properties": {
            "enabled": { "type": "boolean" },
            "demo_number": { "type": "string", "minLength": 6 },
            "lead_endpoint": { "type": "string", "minLength": 1 },
            "fallback_text": { "type": "string", "minLength": 10 },
            "no_recording_default": { "type": "boolean" }
          }
        },
        "analytics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "gtm_id": { "type": "string" }
          }
        }
      }
    }
  },
  "$defs": {
    "cta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label","type"],
      "properties": {
        "label": { "type": "string", "minLength": 2 },
        "type": { "type": "string", "enum": ["tel","chat","form","link"] },
        "value": { "type": "string" },
        "track_id": { "type": "string" }
      }
    },
    "phone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label","e164","display"],
      "properties": {
        "label": { "type": "string", "minLength": 2 },
        "e164": { "type": "string", "pattern": "^\\+[1-9]\\d{6,14}$" },
        "display": { "type": "string", "minLength": 6 }
      }
    },
    "badge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label"],
      "properties": {
        "label": { "type": "string", "minLength": 2 },
        "icon": { "type": "string" }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title","description","icon","cta_mode"],
      "properties": {
        "title": { "type": "string", "minLength": 2 },
        "description": { "type": "string", "minLength": 10 },
        "icon": { "type": "string", "minLength": 2 },
        "cta_mode": { "type": "string", "enum": ["normal","emergency"] }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["author","rating","text"],
      "properties": {
        "author": { "type": "string", "minLength": 2 },
        "rating": { "type": "number", "minimum": 1, "maximum": 5 },
        "text": { "type": "string", "minLength": 10 }
      }
    },
    "form_field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key","label","type","required"],
      "properties": {
        "key": { "type": "string", "minLength": 2 },
        "label": { "type": "string", "minLength": 2 },
        "type": { "type": "string", "enum": ["text","tel","textarea","select"] },
        "required": { "type": "boolean" },
        "options": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
